<Window x:Class="WinFence.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinFence.App"
        mc:Ignorable="d"
        Title="WinFence M0"
        Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border x:Name="RootBorder"
            Background="#CC2A2A2A"
            CornerRadius="12"
            Padding="24"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <StackPanel>
            <TextBlock Text="WinFence"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold" />
            <TextBlock Text="M0 — 透明无边框窗口验证"
                       Foreground="#CCFFFFFF"
                       FontSize="14"
                       Margin="0,8,0,0" />
            <TextBlock Text="按住拖动 · 右键关闭"
                       Foreground="#88FFFFFF"
                       FontSize="11"
                       Margin="0,16,0,0" />
            <TextBlock x:Name="StatusText"
                       Text=""
                       Foreground="#66FFFFFF"
                       FontSize="10"
                       Margin="0,24,0,0" />
        </StackPanel>
    </Border>
</Window>
