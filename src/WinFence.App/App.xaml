<Application x:Class="WinFence.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinFence.App"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             xmlns:menu="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- 内嵌的托盘图标 — 用一个简单几何图形当占位(M3 再换成正式 icon) -->
        <DrawingImage x:Key="TrayIconImage">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FFCC66">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0 16,16" RadiusX="3" RadiusY="3" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Application.Resources>
</Application>
